# Public Supabase browser/server-session configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional OpenStreetMap-compatible tile template. The default is the public OSM tile service.
NEXT_PUBLIC_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Server-only Supabase key. Never expose this through NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only password for the three one-click demo accounts.
# Populated in .env.local by node scripts/create-demo-accounts.mjs after creating accounts.
CIVICSYNC_DEMO_PASSWORD=

# Server-only Resend configuration for opt-in notifications.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Server-only Cloudinary configuration for signed evidence uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Hosted development automation only. Verify this non-secret project ref first;
# never set these to authorize a production target.
CIVICSYNC_REMOTE_TARGET=
CIVICSYNC_REMOTE_PROJECT_REF=

#Run these commands to link your local project to the Supabase project:
#npx.cmd --no-install supabase login
#npx.cmd --no-install supabase link --project-ref wgamzpjhgharmmvzguik
#npm run dev:setup:remote
