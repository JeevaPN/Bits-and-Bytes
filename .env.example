# Public Supabase browser/server-session configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase key. Never expose this through NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Resend configuration for opt-in notifications.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Server-only Cloudinary configuration for signed evidence uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
